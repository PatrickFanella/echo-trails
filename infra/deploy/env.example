# EchoTrails deploy environment template. Do not put secrets here.
ECHOTRAILS_ENV=staging
ECHOTRAILS_API_BASE_URL=https://api.echotrails.example
ECHOTRAILS_PUBLIC_WEB_URL=https://echotrails.example
ECHOTRAILS_ADMIN_WEB_URL=https://admin.echotrails.example
ECHOTRAILS_DATABASE_URL=provided-by-secret-store
ECHOTRAILS_POSTGRES_DB=echotrails
ECHOTRAILS_POSTGRES_USER=echotrails
ECHOTRAILS_POSTGRES_PASSWORD=provided-by-secret-store
ECHOTRAILS_REDIS_URL=provided-by-secret-store
ECHOTRAILS_MEDIA_BUCKET=echotrails-media-staging
ECHOTRAILS_S3_BUCKET=echotrails-media-staging
ECHOTRAILS_S3_ENDPOINT=http://object-storage:9000
ECHOTRAILS_S3_REGION=us-east-1
ECHOTRAILS_S3_ACCESS_KEY_ID=provided-by-secret-store
ECHOTRAILS_S3_SECRET_ACCESS_KEY=provided-by-secret-store
ECHOTRAILS_ENABLE_DEV_MEDIA_WRITES=false
ECHOTRAILS_MODERATION_SERVICE_URL=http://private-moderation-host:8081
ECHOTRAILS_MODERATION_SERVICE_TOKEN=provided-by-secret-store
ECHOTRAILS_WHISPER_MODEL=large-v3-turbo
ECHOTRAILS_WHISPER_REVISION=provided-by-deployment-pinned-commit
ECHOTRAILS_SHIELDGEMMA_MODEL=google/shieldgemma-2b
ECHOTRAILS_SHIELDGEMMA_REVISION=provided-by-deployment-pinned-commit
ECHOTRAILS_SHIELDGEMMA2_MODEL=google/shieldgemma-2-4b-it
ECHOTRAILS_SHIELDGEMMA2_REVISION=provided-by-deployment-pinned-commit
ECHOTRAILS_FFMPEG_PATH=ffmpeg
ECHOTRAILS_FFPROBE_PATH=ffprobe
ECHOTRAILS_IMAGEMAGICK_PATH=convert
ECHOTRAILS_MALWARE_SCANNER_PATH=clamdscan
ECHOTRAILS_SMTP_HOST=provided-by-secret-store
ECHOTRAILS_SMTP_PORT=587
ECHOTRAILS_SMTP_USERNAME=provided-by-secret-store
ECHOTRAILS_SMTP_PASSWORD=provided-by-secret-store
ECHOTRAILS_SMTP_FROM=no-reply@echotrails.example
ECHOTRAILS_AUTH_LINK_BASE_URL=https://echotrails.example
ECHOTRAILS_SMTP_ALLOW_INSECURE=0
ECHOTRAILS_APNS_TEAM_ID=provided-by-secret-store
ECHOTRAILS_APNS_KEY_ID=provided-by-secret-store
ECHOTRAILS_APNS_BUNDLE_ID=com.echotrails.app
ECHOTRAILS_APNS_PRIVATE_KEY_PATH=/run/secrets/apns-private-key.p8
ECHOTRAILS_APNS_PRIVATE_KEY_HOST_PATH=provided-outside-repository
# Override only for a private APNs-compatible test server.
ECHOTRAILS_APNS_SANDBOX_ENDPOINT=
ECHOTRAILS_APNS_PRODUCTION_ENDPOINT=
ECHOTRAILS_AUTH_CODE_PEPPER=provided-by-secret-store-at-least-32-bytes
ECHOTRAILS_CREATION_TOKEN_SIGNING_KEY=provided-by-secret-store-at-least-32-bytes
ECHOTRAILS_PUBLIC_LOCATION_KEY=provided-by-secret-store-at-least-32-bytes
ECHOTRAILS_EXACT_LOCATION_ENCRYPTION_KEY=provided-by-secret-store-at-least-32-bytes
ECHOTRAILS_PUSH_TOKEN_ENCRYPTION_KEY=provided-by-secret-store-at-least-32-bytes
ECHOTRAILS_APPLE_CLIENT_ID=com.echotrails.app
ECHOTRAILS_WORKER_STREAM=echotrails:jobs
ECHOTRAILS_WORKER_GROUP=echotrails-workers
ECHOTRAILS_WORKER_CONSUMER=worker-1
